<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:OpenMount.App"
                    xmlns:vm="clr-namespace:OpenMount.App.ViewModels">
  <!-- Design tokens and shared styles from the 2026-10-23 design (artboard "设计规范"): one blue, one grey,
       status colours fixed per dimension (lifecycle / remote health / sync). Light theme only for now. -->

  <!-- ===== tokens ===== -->
  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
  <Color x:Key="AccentColor">#2457E6</Color>

  <SolidColorBrush x:Key="WindowBrush" Color="#F5F6F8" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E6EA" />
  <SolidColorBrush x:Key="DividerBrush" Color="#EEF1F4" />
  <SolidColorBrush x:Key="FieldBorderBrush" Color="#D5DAE1" />
  <SolidColorBrush x:Key="TextBrush" Color="#1B1F24" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3F4752" />
  <SolidColorBrush x:Key="MutedBrush" Color="#5C6470" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#9AA3AE" />
  <SolidColorBrush x:Key="AccentBrush" Color="#2457E6" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A43B5" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8EFFF" />
  <SolidColorBrush x:Key="TileBrush" Color="#F3F5F8" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
  <SolidColorBrush x:Key="WarnBrush" Color="#D97706" />
  <SolidColorBrush x:Key="SyncBrush" Color="#1E3FA8" />
  <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
  <SolidColorBrush x:Key="RingBrush" Color="#8A93A0" />
  <SolidColorBrush x:Key="SeparatorDotBrush" Color="#C9CED6" />
  <SolidColorBrush x:Key="ProgressTrackBrush" Color="#DCE4FB" />

  <SolidColorBrush x:Key="ChipNeutralBg" Color="#F3F5F8" />
  <SolidColorBrush x:Key="ChipNeutralBorder" Color="#DDE2E8" />
  <SolidColorBrush x:Key="ChipNeutralFg" Color="#3F4752" />
  <SolidColorBrush x:Key="ChipOkBg" Color="#E8F5EE" />
  <SolidColorBrush x:Key="ChipOkBorder" Color="#BFE3CF" />
  <SolidColorBrush x:Key="ChipOkFg" Color="#166534" />
  <SolidColorBrush x:Key="ChipWarnBg" Color="#FFF4E0" />
  <SolidColorBrush x:Key="ChipWarnBorder" Color="#F5D9A6" />
  <SolidColorBrush x:Key="ChipWarnFg" Color="#8A4B06" />
  <SolidColorBrush x:Key="ChipInfoBg" Color="#E8EFFF" />
  <SolidColorBrush x:Key="ChipInfoBorder" Color="#C5D4FA" />
  <SolidColorBrush x:Key="ChipInfoFg" Color="#1E3FA8" />
  <SolidColorBrush x:Key="ChipErrorBg" Color="#FFF5F5" />
  <SolidColorBrush x:Key="ChipErrorBorder" Color="#E5B4B4" />
  <SolidColorBrush x:Key="ChipErrorFg" Color="#9B1C1C" />
  <SolidColorBrush x:Key="WarnBannerFg" Color="#6B3B04" />
  <SolidColorBrush x:Key="WarnCardBg" Color="#FFFBF2" />
  <SolidColorBrush x:Key="InfoCardBg" Color="#F6F8FF" />

  <!-- ===== converters ===== -->
  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <local:InverseBoolConverter x:Key="InverseBool" />
  <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
  <local:HttpsToIndexConverter x:Key="HttpsToIndex" />
  <local:EqualsToVisibilityConverter x:Key="EqVis" />
  <local:NotNullToVisibilityConverter x:Key="NotNullVis" />
  <local:StringNotEmptyToVisibilityConverter x:Key="TextVis" />

  <!-- ===== text ===== -->
  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="DialogTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style x:Key="Help" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style x:Key="StatusBarText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="SeparatorDot" TargetType="TextBlock" BasedOn="{StaticResource StatusBarText}">
    <Setter Property="Text" Value="·" />
    <Setter Property="Foreground" Value="{StaticResource SeparatorDotBrush}" />
    <Setter Property="Margin" Value="8,0" />
  </Style>

  <!-- ===== windows ===== -->
  <Style x:Key="AppWindow" TargetType="Window">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="Icon" Value="pack://application:,,,/Assets/OpenMount.ico" />
  </Style>
  <Style x:Key="DialogWindow" TargetType="Window" BasedOn="{StaticResource AppWindow}">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="ResizeMode" Value="NoResize" />
    <Setter Property="ShowInTaskbar" Value="False" />
    <Setter Property="SizeToContent" Value="Height" />
    <!-- WindowStartupLocation is not a dependency property: DialogFrame.Setup sets CenterOwner in code. -->
  </Style>

  <!-- ===== buttons (WPF-UI Button keeps hover/pressed states per appearance) ===== -->
  <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="DangerButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Background" Value="{StaticResource ChipErrorBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource ChipErrorBorder}" />
    <Setter Property="Foreground" Value="{StaticResource ChipErrorFg}" />
    <Setter Property="MouseOverBackground" Value="#FFE9E9" />
    <Setter Property="MouseOverBorderBrush" Value="{StaticResource ChipErrorBorder}" />
    <Setter Property="PressedBackground" Value="#FFDADA" />
    <Setter Property="PressedForeground" Value="{StaticResource ChipErrorFg}" />
  </Style>
  <Style x:Key="LinkButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Appearance" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <!-- ===== fields ===== -->
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- WPF-UI's template for the system PasswordBox renders only the reveal button on Windows 11 (verified 2026-10-23),
       so the classic control gets a small Fluent-looking template of its own. -->
  <Style TargetType="PasswordBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="PasswordChar" Value="●" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource TileBrush}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Margin" Value="0,0,16,0" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <!-- ===== surfaces ===== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style x:Key="WarnBanner" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ChipWarnBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource ChipWarnBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource WarnBannerFg}" />
  </Style>
  <Style x:Key="InfoBanner" TargetType="Border" BasedOn="{StaticResource WarnBanner}">
    <Setter Property="Background" Value="{StaticResource ChipInfoBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource ChipInfoBorder}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource ChipInfoFg}" />
  </Style>
  <Style x:Key="OkBanner" TargetType="Border" BasedOn="{StaticResource InfoBanner}">
    <Setter Property="Background" Value="{StaticResource ChipOkBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource ChipOkBorder}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource ChipOkFg}" />
  </Style>
  <Style x:Key="ErrorBanner" TargetType="Border" BasedOn="{StaticResource InfoBanner}">
    <Setter Property="Background" Value="{StaticResource ChipErrorBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource ChipErrorBorder}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource ChipErrorFg}" />
  </Style>
  <!-- dialog footers (white dialogs get the grey strip; grey windows get the white strip) -->
  <Style x:Key="DialogFooter" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="20,12" />
  </Style>
  <Style x:Key="WindowFooter" TargetType="Border" BasedOn="{StaticResource DialogFooter}">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
  </Style>
  <!-- 40 px icon tile in front of a drive / dialog message -->
  <Style x:Key="IconTile" TargetType="Border">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style x:Key="StatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!-- ===== chips: Text + Kind (colour family) + Mark (leading glyph) ===== -->
  <Style x:Key="ChipBorder" TargetType="Border">
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource ChipNeutralBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource ChipNeutralBorder}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource ChipNeutralFg}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="Ok">
        <Setter Property="Background" Value="{StaticResource ChipOkBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChipOkBorder}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ChipOkFg}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Warn">
        <Setter Property="Background" Value="{StaticResource ChipWarnBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChipWarnBorder}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ChipWarnFg}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Info">
        <Setter Property="Background" Value="{StaticResource ChipInfoBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChipInfoBorder}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ChipInfoFg}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Error">
        <Setter Property="Background" Value="{StaticResource ChipErrorBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChipErrorBorder}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ChipErrorFg}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:Chip}">
    <Border Style="{StaticResource ChipBorder}" ToolTip="{Binding ToolTip}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}"
                 Visibility="{Binding Mark, Converter={StaticResource EqVis}, ConverterParameter=Dot}" />
        <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" Stroke="{StaticResource RingBrush}" StrokeThickness="1.5"
                 Visibility="{Binding Mark, Converter={StaticResource EqVis}, ConverterParameter=Ring}" />
        <ui:ProgressRing Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" IsIndeterminate="True"
                         Visibility="{Binding Mark, Converter={StaticResource EqVis}, ConverterParameter=Spinner}" />
        <ui:SymbolIcon Symbol="ErrorCircle16" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"
                       Visibility="{Binding Mark, Converter={StaticResource EqVis}, ConverterParameter=Alert}" />
        <ui:SymbolIcon Symbol="ArrowUp16" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"
                       Visibility="{Binding Mark, Converter={StaticResource EqVis}, ConverterParameter=Upload}" />
        <ui:SymbolIcon Symbol="Checkmark16" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"
                       Visibility="{Binding Mark, Converter={StaticResource EqVis}, ConverterParameter=Check}" />
        <TextBlock Text="{Binding Text}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </DataTemplate>
  <Style x:Key="ChipList" TargetType="ItemsControl">
    <Setter Property="ItemTemplate" Value="{StaticResource ChipTemplate}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== settings rows ===== -->
  <Style x:Key="SettingRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,12" />
  </Style>
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource TileBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
              <Setter Property="Foreground" Value="{StaticResource ChipInfoFg}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
