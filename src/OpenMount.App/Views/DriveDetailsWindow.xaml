<Window x:Class="OpenMount.App.Views.DriveDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="驱动器详情" Width="760" Height="600" MinWidth="680" MinHeight="480"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="CardLabel" TargetType="TextBlock" BasedOn="{StaticResource Help}" />
    <Style x:Key="CardValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SmallGhost" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- danger footer -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource WindowFooter}" Padding="18,10">
      <DockPanel>
        <ui:Button x:Name="DiscardButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="丢弃未上传数据…" Click="Discard_Click" />
        <TextBlock x:Name="FooterNote" Style="{StaticResource Help}" VerticalAlignment="Center" Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,18,0">
      <StackPanel Margin="0,0,0,12">
        <!-- header -->
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="TypeTile" Style="{StaticResource IconTile}" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center">
            <ui:SymbolIcon x:Name="TypeIcon" Symbol="Globe24" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <WrapPanel>
              <TextBlock x:Name="NameText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock x:Name="LetterText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,2,10,0" />
              <ItemsControl x:Name="HeaderChips" Style="{StaticResource ChipList}" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock x:Name="SubText" Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button x:Name="OpenButton" Content="在资源管理器中打开" Click="Open_Click" />
            <ui:Button x:Name="ToggleButton" Content="断开" Margin="8,0,0,0" Click="Toggle_Click" MinWidth="72" />
          </StackPanel>
        </Grid>

        <!-- three dimensions -->
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="LifecycleCard" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
              <TextBlock Text="生命周期" Style="{StaticResource CardLabel}" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                <Ellipse x:Name="LifecycleDot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource RingBrush}" />
                <TextBlock x:Name="LifecycleText" Style="{StaticResource CardValue}" />
              </StackPanel>
              <TextBlock x:Name="LifecycleDetail" Style="{StaticResource CardLabel}" />
            </StackPanel>
          </Border>
          <Border x:Name="HealthCard" Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
              <TextBlock Text="远端健康" Style="{StaticResource CardLabel}" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                <ui:SymbolIcon x:Name="HealthIcon" Symbol="Checkmark16" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="HealthText" Style="{StaticResource CardValue}" />
              </StackPanel>
              <TextBlock x:Name="HealthDetail" Style="{StaticResource CardLabel}" />
            </StackPanel>
          </Border>
          <Border x:Name="SyncCard" Grid.Column="4" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
              <TextBlock Text="同步状态" Style="{StaticResource CardLabel}" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                <ui:SymbolIcon x:Name="SyncIcon" Symbol="Checkmark16" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="SyncText" Style="{StaticResource CardValue}" />
              </StackPanel>
              <ProgressBar x:Name="SyncProgress" Height="6" IsIndeterminate="True" Margin="0,0,0,6" Visibility="Collapsed" />
              <TextBlock x:Name="SyncDetail" Style="{StaticResource CardLabel}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- cache + command line -->
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
              <TextBlock Text="本地缓存" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
              <TextBlock x:Name="CacheText" Style="{StaticResource BodyText}" />
              <TextBlock x:Name="CachePath" Style="{StaticResource Mono}" Margin="0,4,0,0" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Margin="-8,6,0,0">
                <ui:Button Style="{StaticResource SmallGhost}" Content="打开目录" Click="OpenCache_Click" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource SmallGhost}" Content="复制" Click="CopyCommand_Click" />
                <TextBlock Text="rclone 命令行" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="CommandText" Style="{StaticResource Mono}" TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="ErrorCard" Style="{StaticResource Card}" Padding="14,12" Visibility="Collapsed" BorderBrush="{StaticResource ChipErrorBorder}" Background="{StaticResource ChipErrorBg}">
          <StackPanel>
            <TextBlock x:Name="ErrorTitle" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ChipErrorFg}" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource Help}" Foreground="{StaticResource ChipErrorFg}" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
