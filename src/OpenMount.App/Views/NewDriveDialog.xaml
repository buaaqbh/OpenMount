<Window x:Class="OpenMount.App.Views.NewDriveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:OpenMount.App"
        Title="{Binding Title}" Width="720" Height="780" MinWidth="680" MinHeight="600"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <local:PresetSymbolConverter x:Key="PresetSymbol" />
    <!-- storage tiles -->
    <Style x:Key="Tile" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="6,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon x:Name="Icon" Symbol="{Binding Id, Converter={StaticResource PresetSymbol}}" FontSize="22" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DisplayName}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RingBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                <Setter TargetName="Bd" Property="Padding" Value="5,9" />
                <Setter TargetName="Bd" Property="Background" Value="#F3F6FF" />
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FormGrid" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,0" />
    </Style>
    <Style x:Key="Row" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
      <Setter Property="Margin" Value="0,0,12,8" />
      <Setter Property="Width" Value="76" />
    </Style>
    <Style x:Key="Inline" TargetType="TextBlock" BasedOn="{StaticResource Help}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="InlineLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
      <Setter Property="Margin" Value="12,0,8,0" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- footer -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource WindowFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ui:Button Appearance="Transparent" Content="取消" Click="Cancel_Click" IsCancel="True" />
          <ui:Button Appearance="Primary" Content="连接" Padding="18,4" Margin="8,0,0,0" Click="Connect_Click" IsDefault="True" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <ui:Button Content="仅保存" Click="Save_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,0">
      <StackPanel Margin="0,0,0,16">
        <!-- storage -->
        <TextBlock Text="存储" Style="{StaticResource SectionHeader}" />
        <ListBox ItemsSource="{Binding StoragePresets}" SelectedItem="{Binding SelectedPreset}" IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBool}}"
                 ItemContainerStyle="{StaticResource Tile}" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,-8,16"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>

        <!-- drive -->
        <TextBlock Text="驱动器" Style="{StaticResource SectionHeader}" />
        <StackPanel Style="{StaticResource Row}">
          <TextBlock Text="挂载点" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
          <RadioButton Content="盘符" IsChecked="{Binding UseDriveLetter}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding AvailableLetters}" SelectedItem="{Binding DriveLetter}" Width="84" Margin="6,0,0,0" IsEnabled="{Binding UseDriveLetter}" />
          <RadioButton Content="文件夹" IsChecked="{Binding UseDriveLetter, Converter={StaticResource InverseBool}}" Margin="16,0,0,0" IsEnabled="{Binding LocalDisk}" VerticalAlignment="Center"
                       ToolTip="仅“作为本地磁盘”模式可用" />
          <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" Width="250" Margin="6,0,0,0" IsEnabled="{Binding UseDriveLetter, Converter={StaticResource InverseBool}}"
                   ToolTip="本地 NTFS 磁盘上尚不存在的新文件夹，例如 D:\mounts\photos" />
          <ui:Button Content="…" Width="36" Padding="0" Margin="6,0,0,0" Click="BrowseFolder_Click" IsEnabled="{Binding UseDriveLetter, Converter={StaticResource InverseBool}}" />
        </StackPanel>
        <StackPanel Style="{StaticResource Row}">
          <TextBlock Text="名称" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="260" MaxLength="32" ToolTip="显示为卷标，不可与其它驱动器重复" />
        </StackPanel>
        <StackPanel Style="{StaticResource Row}">
          <TextBlock Text="凭据" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
          <ComboBox ItemsSource="{Binding CredentialPolicies}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CredentialPolicy}" Width="220" />
        </StackPanel>
        <WrapPanel Margin="88,0,0,4">
          <CheckBox Content="程序启动时自动连接" IsChecked="{Binding AutoConnectAtStart}" />
          <CheckBox Content="连接断开后自动重连" IsChecked="{Binding AutoReconnect}" />
          <CheckBox Content="只读" IsChecked="{Binding ReadOnly}" />
          <CheckBox Content="作为本地磁盘" IsChecked="{Binding LocalDisk}" ToolTip="显示在“设备和驱动器”而不是“网络位置”；少数只接受本地盘的软件需要" />
          <CheckBox Content="使用代理" IsChecked="{Binding UseProxy}" />
        </WrapPanel>
        <Border Height="12" />

        <!-- connection: WebDAV -->
        <StackPanel Visibility="{Binding IsWebDav, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="连接信息 · WebDAV" Style="{StaticResource SectionHeader}" />
          <StackPanel Style="{StaticResource Row}">
            <TextBlock Text="地址" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <ComboBox Width="86" SelectedIndex="{Binding Https, Converter={StaticResource HttpsToIndex}}">
              <ComboBoxItem Content="https" />
              <ComboBoxItem Content="http" />
            </ComboBox>
            <TextBlock Style="{StaticResource Inline}" Text="://" />
            <TextBox Text="{Binding WebDavHost, UpdateSourceTrigger=PropertyChanged}" Width="200" />
            <TextBlock Style="{StaticResource Inline}" Text=":" />
            <TextBox Text="{Binding WebDavPort, UpdateSourceTrigger=PropertyChanged}" Width="66" ToolTip="留空使用默认端口" />
            <TextBlock Style="{StaticResource Inline}" Text="/" />
            <TextBox Text="{Binding WebDavPath, UpdateSourceTrigger=PropertyChanged}" Width="150" />
          </StackPanel>
          <Border Style="{StaticResource WarnBanner}" Padding="12,8" Margin="88,0,0,8" Visibility="{Binding ShowPlainHttpWarning, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Warning16" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock FontSize="12" TextWrapping="Wrap" Text="明文 HTTP：账号密码与文件内容不加密传输。" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <StackPanel Style="{StaticResource Row}">
            <TextBlock Text="认证方式" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <ComboBox ItemsSource="{Binding WebDavAuthModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding WebDavAuthMode}" Width="160" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}" Visibility="{Binding WebDavUsesBasic, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="账号" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <TextBox Text="{Binding WebDavUsername, UpdateSourceTrigger=PropertyChanged}" Width="260" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}" Visibility="{Binding WebDavUsesBasic, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="密码" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <PasswordBox x:Name="WebDavPassword" Width="260" />
            <TextBlock Style="{StaticResource Inline}" Text="{Binding SecretHint}" Margin="10,0,0,0" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}" Visibility="{Binding WebDavUsesBearer, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Token" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <PasswordBox x:Name="BearerToken" Width="360" />
            <TextBlock Style="{StaticResource Inline}" Text="{Binding SecretHint}" Margin="10,0,0,0" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}">
            <TextBlock Text="服务器类型" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <ComboBox ItemsSource="{Binding Vendors}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Vendor}" Width="160" />
            <TextBlock Text="证书" Style="{StaticResource InlineLabel}" />
            <ComboBox ItemsSource="{Binding TlsModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TlsMode}" Width="150" IsEnabled="{Binding Https}" />
            <TextBlock Text="超时" Style="{StaticResource InlineLabel}" />
            <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="56" />
            <TextBlock Style="{StaticResource Inline}" Text="秒" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}" Visibility="{Binding TlsUsesCustomCa, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="CA 证书" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <TextBox Text="{Binding CaCertPath, UpdateSourceTrigger=PropertyChanged}" Width="360" />
            <ui:Button Content="…" Width="36" Padding="0" Margin="6,0,0,0" Click="BrowseCa_Click" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}" Margin="0,0,0,16">
            <TextBlock Text="目标" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <TextBlock Text="{Binding Preview}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- connection: SFTP -->
        <StackPanel Visibility="{Binding IsSftp, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="连接信息 · SFTP" Style="{StaticResource SectionHeader}" />
          <StackPanel Style="{StaticResource Row}">
            <TextBlock Text="主机" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <TextBox Text="{Binding SftpHost, UpdateSourceTrigger=PropertyChanged}" Width="220" />
            <TextBlock Text="端口" Style="{StaticResource InlineLabel}" />
            <TextBox Text="{Binding SftpPort, UpdateSourceTrigger=PropertyChanged}" Width="66" />
            <TextBlock Text="账号" Style="{StaticResource InlineLabel}" />
            <TextBox Text="{Binding SftpUsername, UpdateSourceTrigger=PropertyChanged}" Width="160" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}">
            <TextBlock Text="验证方式" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <ComboBox ItemsSource="{Binding SftpAuthModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SftpAuthMode}" Width="160" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}" Visibility="{Binding SftpUsesPassword, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="登录密码" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <PasswordBox x:Name="SftpPassword" Width="260" />
            <TextBlock Style="{StaticResource Inline}" Text="{Binding SecretHint}" Margin="10,0,0,0" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}" Visibility="{Binding SftpUsesKey, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="私钥文件" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <TextBox Text="{Binding KeyFilePath, UpdateSourceTrigger=PropertyChanged}" Width="360" ToolTip="OpenSSH 格式的私钥文件" />
            <ui:Button Content="…" Width="36" Padding="0" Margin="6,0,0,0" Click="BrowseKey_Click" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}" Visibility="{Binding SftpUsesKey, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="私钥口令" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <PasswordBox x:Name="KeyPassphrase" Width="260" ToolTip="私钥文件没有口令时留空" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}">
            <TextBlock Text="远程目录" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <TextBox Text="{Binding SftpPath, UpdateSourceTrigger=PropertyChanged}" Width="260" ToolTip="相对账号主目录；以 / 开头为绝对路径；留空 = 主目录" />
            <TextBlock Style="{StaticResource Inline}" Text="{Binding SftpPathHint}" Margin="10,0,0,0" ToolTip="相对账号主目录；以 / 开头为绝对路径；留空 = 主目录" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}">
            <TextBlock Text="主机密钥" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <ComboBox Width="200" SelectedIndex="{Binding VerifyHostKey, Converter={StaticResource HttpsToIndex}}" ToolTip="首次连接时核对服务器指纹">
              <ComboBoxItem Content="首次连接时确认（推荐）" />
              <ComboBoxItem Content="不校验（不推荐）" />
            </ComboBox>
          </StackPanel>
          <WrapPanel Margin="88,0,0,8">
            <CheckBox Content="保持文件修改时间" IsChecked="{Binding SetModTime}" />
            <CheckBox Content="禁用校验和检查" IsChecked="{Binding DisableHashCheck}" />
          </WrapPanel>
          <StackPanel Style="{StaticResource Row}" Margin="0,0,0,16">
            <TextBlock Text="目标" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
            <TextBlock Text="{Binding Preview}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- advanced -->
        <ui:CardExpander Header="高级选项" Icon="{ui:SymbolIcon Settings24}" ContentPadding="16,12" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Style="{StaticResource Help}" Text="留空的项跟随全局设置。" Margin="0,0,0,10" />
            <StackPanel Style="{StaticResource Row}">
              <TextBlock Text="缓存模式" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
              <ComboBox ItemsSource="{Binding CacheModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CacheMode}" Width="140" />
              <TextBlock Text="清理目标" Style="{StaticResource InlineLabel}" />
              <TextBox Text="{Binding CacheCleanupTarget, UpdateSourceTrigger=PropertyChanged}" Width="70" ToolTip="如 10G；清理目标不是硬上限" />
              <TextBlock Text="保留" Style="{StaticResource InlineLabel}" />
              <TextBox Text="{Binding CacheMaxAge, UpdateSourceTrigger=PropertyChanged}" Width="70" ToolTip="如 24h" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
              <TextBlock Text="显示" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
              <TextBlock Text="报告容量" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
              <TextBox Text="{Binding ReportedCapacity, UpdateSourceTrigger=PropertyChanged}" Width="70" ToolTip="如 1T；留空自动" />
              <CheckBox Content="文件系统名报告为 NTFS" IsChecked="{Binding ReportAsNtfs}" Margin="16,0,16,0" />
              <CheckBox Content="隐藏点文件" IsChecked="{Binding DotHidden}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
              <TextBlock Text="带宽限制" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
              <TextBlock Text="上传" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
              <TextBox Text="{Binding BwLimitUp, UpdateSourceTrigger=PropertyChanged}" Width="70" ToolTip="如 10M；留空不限" />
              <TextBlock Text="下载" Style="{StaticResource InlineLabel}" />
              <TextBox Text="{Binding BwLimitDown, UpdateSourceTrigger=PropertyChanged}" Width="70" />
            </StackPanel>
            <TextBlock Text="最终命令行" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
            <TextBox Text="{Binding CommandLinePreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5" MaxHeight="96" VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </ui:CardExpander>

        <!-- validation -->
        <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ValidationText, Converter={StaticResource TextVis}}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ErrorCircle16" FontSize="14" VerticalAlignment="Top" Margin="0,2,8,0" />
            <TextBlock Text="{Binding ValidationText}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="600" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
