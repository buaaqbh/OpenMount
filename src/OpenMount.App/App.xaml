<Application x:Class="OpenMount.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- WPF-UI (MIT): Fluent/Windows 11 templates for the standard controls. -->
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <!-- OpenMount design tokens, chips and shared styles (design 2026-10-23). -->
        <ResourceDictionary Source="Themes/Design.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
