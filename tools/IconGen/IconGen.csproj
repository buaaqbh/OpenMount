<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the OpenMount icon family (app, tray states, Explorer drive types) from the design geometry into .ico files.
       Usage: dotnet run -c Release (project tools\IconGen) [output dir]; default output is src\OpenMount.App\Assets. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IconGen</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
